# Copy to tests/.env (git-ignored). Passwords must match the Ansible Vault values.
# ODOO_ADMIN_PASSWORD is the `admin` *login* password (vault_odoo_admin_password),
# not Odoo's database master password.
ODOO_DB_PASSWORD=change-me-odoo-db-password
ODOO_ADMIN_PASSWORD=change-me-odoo-admin-login-password

# Optional — defaults are fine for the lab
# ERP_VIP=192.168.50.10
# DB_VIP=192.168.50.30
# ODOO_DB=ha_erp
# ODOO_USER=odoo
# ANSIBLE_VAULT_PASSWORD_FILE=/home/you/.config/ha-erp/vault-pass
